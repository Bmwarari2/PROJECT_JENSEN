# Copy to .env.local for local development. On Railway, set these in the
# service's "Variables" tab instead (never commit real values).

# --- Login (required) --------------------------------------------------------
# The password you'll type to open the app.
APP_PASSWORD=
# Random string, 32+ characters. Generate one with: openssl rand -base64 48
SESSION_SECRET=

# --- Claude (required) ---------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional. Defaults shown.
# TUTOR_MODEL=claude-opus-5-5
# TUTOR_EFFORT=low            # low | medium | high | xhigh | max (higher = slower, more thorough)

# --- Azure AI Speech (required for voice) --------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Optional voices. Defaults shown. Set both to zh-CN-XiaoxiaoMultilingualNeural
# for a single bilingual voice.
# TTS_VOICE_EN=en-US-AvaMultilingualNeural
# TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
# Optional. Empty = automatic English/Mandarin detection.
# STT_LOCALES=

# --- Supabase (required) -------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The *secret* key (Project Settings → API Keys). Server-side only.
SUPABASE_SECRET_KEY=
