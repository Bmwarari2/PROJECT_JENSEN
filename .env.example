# Copy to .env.local for local development. On Railway, set these in the
# service's "Variables" tab instead (never commit real values).

# --- Login (required) --------------------------------------------------------
# The password you'll type to open the app.
APP_PASSWORD=
# Random string, 32+ characters. Generate one with: openssl rand -base64 48
SESSION_SECRET=

# --- Claude (required) ---------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional. Defaults shown.
# TUTOR_MODEL=claude-opus-5-5
# TUTOR_EFFORT=low            # low | medium | high | xhigh | max (higher = slower, more thorough)

# --- Voice: set ElevenLabs, Azure, or both ---------------------------------------
# ElevenLabs alone handles listening, speaking, and a "clarity check" for
# pronunciation. Adding Azure upgrades pronunciation scoring to Azure's
# phoneme-level assessment.

# ElevenLabs (https://elevenlabs.io → Developers → API keys)
ELEVENLABS_API_KEY=
# Optional. Defaults shown. Find voice IDs in ElevenLabs → Voices.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb     # "George"; used for English (and Chinese unless set below)
# ELEVENLABS_VOICE_ID_ZH=                       # e.g. a native Mandarin voice from the Voice Library
# ELEVENLABS_TTS_MODEL=eleven_v4
# ELEVENLABS_STT_MODEL=scribe_v3

# Azure AI Speech (optional with ElevenLabs; Azure portal → Speech resource → Keys and Endpoint)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional. Defaults shown.
# TTS_VOICE_EN=en-US-AvaMultilingualNeural
# TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
# STT_LOCALES=                                  # empty = automatic English/Mandarin

# Optional: choose who does what when both are configured.
# Defaults: ElevenLabs listens and speaks; Azure (if set) scores pronunciation.
# STT_PROVIDER=elevenlabs                       # elevenlabs | azure
# TTS_PROVIDER=elevenlabs                       # elevenlabs | azure

# --- Supabase (required) -------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The *secret* key (Project Settings → API Keys). Server-side only.
SUPABASE_SECRET_KEY=
